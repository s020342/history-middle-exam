<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- history-admin：管理端服务模块，承载 React 后台 API（题库/看板/运营） -->
    <parent>
        <groupId>com.history.exam</groupId>
        <artifactId>history-exam-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>history-admin</artifactId>
    <name>history-admin</name>
    <description>管理端服务模块：后台 RBAC、题库管理、学习看板、运营配置</description>

    <dependencies>
        <dependency>
            <groupId>com.history.exam</groupId>
            <artifactId>history-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <!-- Lombok：history-common 中为 provided 作用域不传递，本模块需显式声明 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <!-- Redis 缓存：知识点卡片详情缓存 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
    </dependencies>

</project>
