<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- history-student：学生端服务模块，承载小程序 API（登录/题库/训练/错题） -->
    <parent>
        <groupId>com.history.exam</groupId>
        <artifactId>history-exam-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>history-student</artifactId>
    <name>history-student</name>
    <description>学生端服务模块：登录、题库、训练、错题、订阅查询</description>

    <dependencies>
        <dependency>
            <groupId>com.history.exam</groupId>
            <artifactId>history-common</artifactId>
        </dependency>
        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <!-- Redis 缓存 -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
        </dependency>
        <!-- 微信小程序登录：使用 HTTP 客户端调用 code2session -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <!-- Lombok：实体/DTO/VO 简化（history-common 中为 provided 作用域不传递，本模块需显式声明） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>

</project>
