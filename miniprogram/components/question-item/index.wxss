.question-card {
  margin: 24rpx;
  padding: 32rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
}

.question-stem {
  font-size: 32rpx;
  line-height: 1.6;
  color: #303133;
}

.stem-type {
  color: #3a7bd5;
  font-weight: 500;
  margin-right: 8rpx;
}

.stem-text {
  word-break: break-all;
}

/* 选项 */
.option-list {
  margin-top: 32rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #ebeef5;
  border-radius: 12rpx;
  background: #fff;
}

.option-item:active {
  background: #f5f6f8;
}

.option-key {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f5f6f8;
  color: #606266;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.option-content {
  flex: 1;
  font-size: 30rpx;
  color: #303133;
}

.option-selected {
  border-color: #3a7bd5;
  background: #e8f0fe;
}

.option-selected .option-key {
  background: #3a7bd5;
  color: #fff;
}

.option-correct {
  border-color: #34c759;
  background: #e8f9ec;
}

.option-correct .option-key {
  background: #34c759;
  color: #fff;
}

.option-wrong {
  border-color: #f5222d;
  background: #fde8e8;
}

.option-wrong .option-key {
  background: #f5222d;
  color: #fff;
}

/* 解析 */
.question-analysis {
  margin-top: 32rpx;
  padding: 24rpx;
  background: #f5f6f8;
  border-radius: 12rpx;
}

.analysis-result {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.result-correct {
  color: #34c759;
}

.result-wrong {
  color: #f5222d;
}

.analysis-text {
  font-size: 28rpx;
  color: #606266;
  line-height: 1.6;
}

.analysis-label {
  color: #3a7bd5;
  font-weight: 500;
}
