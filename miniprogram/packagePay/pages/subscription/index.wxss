.sub-container {
  min-height: 100vh;
  padding-bottom: 200rpx;
}

.sub-header {
  padding: 48rpx 32rpx;
  background: linear-gradient(135deg, #3a7bd5 0%, #5e9ce8 100%);
  color: #fff;
}

.header-title {
  font-size: 40rpx;
  font-weight: 600;
}

.header-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.plan-list {
  margin: 24rpx;
}

.plan-card {
  position: relative;
  margin-bottom: 24rpx;
  padding: 32rpx;
  background: #fff;
  border: 2rpx solid #ebeef5;
  border-radius: 16rpx;
}

.plan-selected {
  border-color: #3a7bd5;
  background: #e8f0fe;
}

.plan-name {
  font-size: 32rpx;
  color: #303133;
  font-weight: 500;
}

.plan-price {
  margin-top: 16rpx;
  display: flex;
  align-items: baseline;
  color: #f5222d;
}

.price-symbol {
  font-size: 28rpx;
}

.price-value {
  font-size: 56rpx;
  font-weight: 700;
}

.price-unit {
  margin-left: 8rpx;
  font-size: 26rpx;
  color: #909399;
}

.plan-check {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #3a7bd5;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.sub-loading {
  text-align: center;
  color: #909399;
  padding: 48rpx;
}

.sub-benefits {
  margin: 24rpx;
  padding: 32rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
}

.benefit-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
}

.benefit-item {
  padding: 12rpx 0;
  font-size: 28rpx;
  color: #606266;
}

.sub-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 24rpx 32rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.sub-footer .btn-primary {
  width: 100%;
}

.agreement {
  margin-top: 16rpx;
  text-align: center;
  color: #909399;
  font-size: 24rpx;
}
