.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 0 48rpx;
  background: linear-gradient(180deg, #3a7bd5 0%, #5e9ce8 50%, #f5f6f8 100%);
}

.login-logo {
  margin-top: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  background: #fff;
  color: #3a7bd5;
  font-size: 80rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.logo-text {
  margin-top: 32rpx;
  color: #fff;
  font-size: 44rpx;
  font-weight: 600;
}

.logo-desc {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
}

.login-actions {
  margin-top: 120rpx;
  width: 100%;
}

.login-actions .btn-primary {
  width: 100%;
}

.skip-btn {
  margin-top: 24rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
  padding: 16rpx 0;
}

.login-agreement {
  margin-top: auto;
  margin-bottom: 60rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  text-align: center;
}
