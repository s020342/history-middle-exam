.home-container {
  padding-bottom: 40rpx;
}

/* 欢迎卡 */
.welcome-card {
  margin: 24rpx;
  padding: 40rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #3a7bd5 0%, #5e9ce8 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 12rpx rgba(58, 123, 213, 0.2);
}

.welcome-text {
  flex: 1;
}

.welcome-title {
  font-size: 40rpx;
  font-weight: 600;
}

.welcome-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.welcome-badge {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.25);
  font-size: 24rpx;
}

.badge-vip {
  background: #ffd700;
  color: #8b6914;
  font-weight: 600;
}

/* 入口列表 */
.entry-list {
  margin: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.entry-item {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  border-bottom: 1rpx solid #f0f2f5;
}

.entry-item:last-child {
  border-bottom: none;
}

.entry-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-train {
  background: #3a7bd5;
}

.icon-wrong {
  background: #f5222d;
}

.icon-vip {
  background: #faad14;
}

.entry-meta {
  flex: 1;
  margin-left: 24rpx;
}

.entry-name {
  font-size: 32rpx;
  color: #303133;
  font-weight: 500;
}

.entry-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #909399;
}

.entry-arrow {
  color: #c0c4cc;
  font-size: 40rpx;
}

.home-tip {
  margin: 24rpx;
  padding: 24rpx;
  text-align: center;
  background: #fff7e6;
  color: #faad14;
  border-radius: 16rpx;
  font-size: 26rpx;
}
