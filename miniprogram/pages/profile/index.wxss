.profile-container {
  padding-bottom: 40rpx;
}

.profile-header {
  padding: 60rpx 0 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(180deg, #3a7bd5 0%, #5e9ce8 100%);
  color: #fff;
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.profile-avatar image {
  width: 100%;
  height: 100%;
}

.avatar-default {
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #fff;
}

.profile-name {
  margin-top: 24rpx;
  font-size: 36rpx;
  font-weight: 600;
}

.profile-grade {
  margin-top: 8rpx;
  font-size: 26rpx;
  opacity: 0.85;
}

.profile-card {
  margin: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}

.card-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.card-row:last-child {
  border-bottom: none;
}

.card-label {
  color: #909399;
  font-size: 28rpx;
}

.card-value {
  color: #303133;
  font-size: 28rpx;
}

.profile-actions {
  margin: 48rpx 24rpx;
}

.action-btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 48rpx;
  background: #3a7bd5;
  color: #fff;
  font-size: 32rpx;
  margin-bottom: 24rpx;
}

.action-btn.danger {
  background: #fff;
  color: #f5222d;
  border: 1rpx solid #f5222d;
}
