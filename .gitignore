# ============================================================
# 历史中考训练小程序 - .gitignore
# 覆盖：Java/Maven、微信小程序、Python、Node/React、IDE、OS、密钥
# ============================================================

# ---------- 密钥与敏感信息（严禁入库） ----------
*.key
*.pem
*.p12
*.keystore
private.*.key
.env
.env.*
!.env.example
application-local.yml
application-secret.yml

# ---------- Java / Maven ----------
target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*
.mvn/wrapper/maven-wrapper.jar

# ---------- 微信小程序 ----------
# 项目私有配置含本地 appid/路径，按需忽略
miniprogram/project.private.config.json
# 小程序构建产物
miniprogram/dist/

# ---------- Node / React（管理后台预留） ----------
node_modules/
dist/
build/
.vite/
.cache/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ---------- Python（题库抓取工具） ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.tox/

# ---------- IDE ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------- 日志与临时文件 ----------
logs/
*.log
*.tmp
*.bak

# ---------- 构建产物 / 发布包 ----------
*.tar.gz
*.zip
.auth/
.trae/
prd.md
tools/
scraper/
data/
